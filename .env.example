# ─── 인증 (단일 사용자) ──────────────────────────────────────────────
# argon2 해시. 생성: npm run gen:password
AUTH_PASSWORD_HASH=
# 세션 쿠키 서명 키. 32바이트 이상 랜덤. 생성: openssl rand -base64 48
SESSION_SECRET=

# ─── 원격 저장소 (기록의 정본) ──────────────────────────────────────
# ⚠ 코드 레포가 아니라 데이터 전용 private 레포를 따로 만들 것
# contents:read-write 권한의 Fine-grained PAT
STORE_GITHUB_TOKEN=
STORE_GITHUB_REPO=yourname/career-log-data
STORE_GITHUB_BRANCH=main
# 원격 쓰기 디바운스 (ms). 타이핑마다 커밋하지 않기 위한 묶음 간격
STORE_FLUSH_DEBOUNCE_MS=10000
# 메모리 LRU 캐시에 상주시킬 월 개수
STORE_CACHE_MONTHS=24

# ─── Web Push (VAPID) ───────────────────────────────────────────────
# 생성: npm run gen:vapid
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com

# ─── Claude API (요약 생성) ─────────────────────────────────────────
# 미설정 시 요약 기능은 '수동 작성' 폴백으로 동작 (기록 기능은 영향 없음)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5

# ─── 런타임 ─────────────────────────────────────────────────────────
# 미동기화 쓰기 큐 경로. 과거 기록은 여기 저장되지 않는다
QUEUE_DIR=./queue
TZ=Asia/Seoul
PORT=3000
