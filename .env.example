# ─── 인증 (단일 사용자) ──────────────────────────────────────────────
# argon2 해시. 개발 머신에서 `npm run gen:password` 로 만들어 이 값에 복붙
# (서버에서 만들지 않는다 — 서버엔 npm이 없다)
AUTH_PASSWORD_HASH=
# 세션 쿠키 서명 키. 32자 이상. 개발 머신에서 `npm run gen:secret` 로 만들어 복붙
SESSION_SECRET=

# ─── 원격 저장소 (기록의 정본) ──────────────────────────────────────
# ⚠ 코드 레포가 아니라 데이터 전용 private 레포를 따로 만들 것
# contents:read-write 권한의 Fine-grained PAT
STORE_GITHUB_TOKEN=
STORE_GITHUB_REPO=yourname/career-log-data
STORE_GITHUB_BRANCH=main
# 원격 쓰기 디바운스 (ms). 타이핑마다 커밋하지 않기 위한 묶음 간격
STORE_FLUSH_DEBOUNCE_MS=10000
# 메모리 LRU 캐시에 상주시킬 월 개수
STORE_CACHE_MONTHS=24

# ─── Web Push (VAPID) ───────────────────────────────────────────────
# 생성: npm run gen:vapid
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com

# ─── Claude API (요약 생성) ─────────────────────────────────────────
# 미설정 시 요약 기능은 '수동 작성' 폴백으로 동작 (기록 기능은 영향 없음)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5

# ─── 배포 (docker compose 전용) ─────────────────────────────────────
# compose 가 pull 할 이미지 주소. 자신의 레지스트리/계정으로 바꾼다.
# 로컬 빌드 이미지를 쓰면 비워 두어도 된다(기본값 career-log:latest).
CAREER_LOG_IMAGE=career-log:latest
# 호스트 포트 바인딩. 리버스 프록시가 이 주소로 프록시한다.
# 외부에 직접 열려면 APP_BIND=0.0.0.0 (권장하지 않음 — 프록시를 앞에 둘 것)
APP_BIND=127.0.0.1
APP_PORT=3000

# ─── 런타임 ─────────────────────────────────────────────────────────
# 미동기화 쓰기 큐 경로. 과거 기록은 여기 저장되지 않는다
QUEUE_DIR=./queue
TZ=Asia/Seoul
# 앱이 리스닝할 컨테이너 내부 포트. 보통 바꿀 일 없다.
# 호스트 노출 포트는 위의 APP_PORT 로 조정한다.
PORT=3000
